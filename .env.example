# Copy this file to ".env" (same folder) and fill in the values. ".env" is never committed to git.

# --- Stripe (payments) -------------------------------------------------------
# Start with a TEST key from Stripe Dashboard > Developers > API keys (Test mode).
# Recommended: a restricted key (rk_test_...) with these permissions only:
#   Checkout Sessions: Write · Coupons: Write · Payment Method Configurations: Read
STRIPE_SECRET_KEY=
# Signing secret for /api/stripe/webhook (whsec_...). Locally, "stripe listen" prints it.
STRIPE_WEBHOOK_SECRET=
# Live keys (sk_live_/rk_live_) are refused unless you also set this to 1.
DOCNOVA_STRIPE_LIVE=

# --- Website address -----------------------------------------------------------
# Public https address once hosted, e.g. https://docnova.co.uk (used for Stripe return links and emails).
DOCNOVA_PUBLIC_URL=

# --- Email (optional): order confirmations, dispatch notices, welcome emails ----
DOCNOVA_SMTP_HOST=
DOCNOVA_SMTP_PORT=587
DOCNOVA_SMTP_USER=
DOCNOVA_SMTP_PASSWORD=
DOCNOVA_FROM_EMAIL=
